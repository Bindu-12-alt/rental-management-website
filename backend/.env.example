# =============================================
# RentEase Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/rentease

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# --- Google Sign-In ---
# OAuth 2.0 Web application client ID; safe to expose to the browser.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Admin ---
# The single admin email address allowed to register
ADMIN_EMAIL=your_admin_email@example.com

# --- Email / SMTP ---
# Supports Gmail, Outlook, or any SMTP provider
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM_NAME=RentEase
EMAIL_FROM_ADDRESS=no-reply@rentease.com
# Set to "true" in development to log emails instead of sending
EMAIL_DEV_MODE=true

# --- WhatsApp (Twilio) ---
# Create a free Twilio account at https://www.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to "true" to log messages instead of sending
WHATSAPP_DEV_MODE=true

# --- File Uploads ---
# Max file size in bytes (default 5MB)
UPLOAD_MAX_SIZE=5242880
# Allowed mime types (comma-separated)
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# --- Frontend Origin (for CORS) ---
FRONTEND_ORIGIN=http://localhost:3000

# --- API Base URL (used in generated links in emails) ---
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
