# =============================================
# RentEase Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# =============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# For Atlas, use a database user's exact credentials; URL-encode reserved characters.
# Set authSource to the database where that MongoDB user was created if it is not the URI database.
MONGO_URI=mongodb://localhost:27017/rentease

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# --- Google Sign-In ---
# OAuth 2.0 Web application client ID; safe to expose to the browser.
# In Google Cloud Console, add every deployed frontend origin to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# --- Admin ---
# Set to the admin email allowed to register or use first-time Google sign-in.
ADMIN_EMAIL=your_admin_email@example.com
# Demo seeding is destructive and only intended for a disposable database.
# SEED_DEMO_DATA=true
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_chars

# --- Email / SMTP ---
# Supports Gmail, Outlook, or any SMTP provider
# In production, set EMAIL_DEV_MODE=false and use an app password/provider SMTP credentials.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM_NAME=RentEase
EMAIL_FROM_ADDRESS=no-reply@rentease.com
# Set to "true" to disable delivery (no email is sent)
EMAIL_DEV_MODE=true

# --- DocuSign developer sandbox ---
# Sandbox only; production signing is not enabled by this integration.
# Create a DocuSign developer app, grant one-time JWT consent, and keep the RSA key outside this repository.
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY_PATH=C:\Users\yourname\.config\rentease\docusign_private.key

# --- Admin Contact ---
# Required to receive tenant email messages
# ADMIN_WHATSAPP_PHONE=+919876543210

# --- WhatsApp (Twilio) ---
# Create a free Twilio account at https://www.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to "true" to log messages instead of sending
WHATSAPP_DEV_MODE=true

# --- File Uploads ---
# Max file size in bytes (default 5MB)
UPLOAD_MAX_SIZE=5242880
# Tenant documents support PDF, JPEG, and PNG; maintenance photos support images only.

# --- Frontend Origin (for CORS) ---
# Comma-separated list of deployed frontend origins, including the Vercel URL if used.
FRONTEND_ORIGIN=http://localhost:3000

# --- API Base URL (used in generated links in emails) ---
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
